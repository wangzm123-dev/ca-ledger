# Copy to .env and fill in. NEVER commit .env.
# Sepolia RPC endpoint (public node works; Alchemy/Infura is more reliable)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of a TEST-ONLY wallet holding Sepolia ETH (0x...)
# Get Sepolia ETH from the PoW faucet https://sepolia-faucet.pk910.de/ (paste the wallet ADDRESS, never the key)
DEPLOYER_PRIVATE_KEY=
# Etherscan API key (only needed for source verification)
ETHERSCAN_API_KEY=

# Optional: separate role wallets for the demo. Leave empty to auto-create funded throw-away wallets.
DEVELOPER_PRIVATE_KEY=
VVB_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
HOST_PRIVATE_KEY=
AIRLINE_PRIVATE_KEY=

# Optional deployment parameters
ADMIN_DELAY=86400
MIN_VINTAGE=2016
METHODOLOGY_CODE=VM0047
